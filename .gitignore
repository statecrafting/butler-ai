# Rust
/target
**/*.rs.bk
*.pdb
**/mutants.out*/

# Node / pnpm
node_modules/
/apps/desktop/dist/
/apps/desktop/.vite/

# Tauri build output
/apps/desktop/src-tauri/target/
/apps/desktop/src-tauri/gen/schemas/

# spec-spine: the derived shard trees ARE committed (the coupling gate and the
# staleness check compare against them). Only the wall-clock build metadata
# and on-demand attestations are ignored.
.derived/**/build-meta.json
.derived/attestation/

# Agent tooling is committed (.claude/agents, rules, skills, settings.json);
# per-agent learned memory is local session state.
.claude/agent-memory/
.claude/settings.local.json

# Plan files for /implement-plan are working state, not authority.
/plans/

# OS / editor
.DS_Store
*.swp
.idea/
.vscode/
.env
.env.*
