#!/usr/bin/env sh
# Spec: specs/003-governance-ci/spec.md
#
# Opt-in pre-commit hook: refuse a commit when the committed spec-spine
# artifacts are stale against the working tree. Read-only; never mutates.
#   enable:  git config core.hooksPath .githooks
#   disable: git config --unset core.hooksPath
#   bypass:  git commit --no-verify
set -eu
sc="$(command -v spec-spine 2>/dev/null || true)"
[ -n "$sc" ] || sc="$HOME/.cargo/bin/spec-spine"
if [ ! -x "$sc" ]; then
  echo "[pre-commit] spec-spine not found; run 'make setup' (or commit with --no-verify)" >&2
  exit 1
fi
# Spec-spine spec 075: one verb, both committed trees, read-only. The report
# lines name which tree moved, which the composed exit code cannot, so they are
# printed rather than summarized away.
if ! out="$("$sc" check 2>&1)"; then
  echo "$out" >&2
  echo "[pre-commit] a committed shard tree is stale or invalid: run 'make refresh' and stage .derived/" >&2
  exit 1
fi
